# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# REQUIRED: your numeric Telegram user ID(s), comma-separated.
# Send /id to the bot once to learn your ID.
ALLOWED_USER_IDS=123456789

# Optional private archive channel ID, usually starts with -100.
# Add the bot as a channel administrator with permission to post.
ARCHIVE_CHANNEL_ID=

# OpenAI-compatible Chat Completions API. Free model router default for OpenRouter.
AI_API_KEY=
AI_API_BASE_URL=https://openrouter.ai/api/v1
AI_MODEL=openrouter/free
AI_FALLBACK_MODELS=
AI_TIMEOUT=180
AI_MAX_TOKENS=7000
AI_CONCURRENCY=2
MAX_PROMPT_CHARS=30000
MAX_IMAGE_BYTES=12582912
HISTORY_MESSAGES=16

# Text-to-speech API. If TTS_API_KEY is blank, AI_API_KEY is reused.
TTS_API_KEY=
TTS_API_BASE_URL=https://openrouter.ai/api/v1
TTS_MODEL=fish-audio/s2.1-pro-free:free
TTS_FALLBACK_MODELS=
TTS_DEFAULT_VOICE=default
TTS_DEFAULT_SPEED=1.0
TTS_CHUNK_CHARS=2600
TTS_MAX_CHARS=24000
TTS_TIMEOUT=180

# Locally, leave WEBHOOK_URL blank to use polling.
# Render automatically provides RENDER_EXTERNAL_URL.
WEBHOOK_URL=
# Optional; if blank, a secret is derived from the Telegram token.
WEBHOOK_SECRET=

DATA_DIR=./data
DATABASE_PATH=./data/chatai.sqlite3
PORT=8000
LOG_LEVEL=INFO
