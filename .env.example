# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# REQUIRED: comma-separated Telegram numeric user IDs allowed to use the bot.
# Initially run once, send /id, copy your ID here and restart.
ALLOWED_USER_IDS=123456789
ARCHIVE_CHANNEL_ID=

# ==================== MAIN AI API ====================
# Any OpenAI-compatible chat API: set its Base URL, key, model and endpoint path.
AI_API_KEY=
AI_API_BASE_URL=https://openrouter.ai/api/v1
AI_API_PATH=/chat/completions
AI_API_MODE=openai_chat
AI_MODEL=openrouter/free
AI_FALLBACK_MODELS=
AI_AUTH_HEADER=Authorization
AI_AUTH_PREFIX=Bearer 
AI_EXTRA_HEADERS_JSON={}
AI_TIMEOUT=180
AI_MAX_TOKENS=7000
AI_TEMPERATURE=0.3
AI_CONCURRENCY=2
MAX_PROMPT_CHARS=30000
MAX_IMAGE_BYTES=12582912
HISTORY_MESSAGES=16

# For non-OpenAI-compatible providers set AI_API_MODE=custom_json.
# Template is JSON; whole-string placeholders are replaced with typed values:
# {{model}}, {{messages}}, {{history}}, {{prompt}}, {{user_content}},
# {{system_prompt}}, {{max_tokens}}, {{temperature}}, {{image}}.
# Example AI_REQUEST_TEMPLATE_JSON={"model":"{{model}}","messages":"{{messages}}"}
AI_REQUEST_TEMPLATE_JSON=
# Dot path to text/content inside provider response JSON; array positions are numeric.
# OpenAI Chat Completions: choices.0.message.content
AI_RESPONSE_TEXT_PATH=choices.0.message.content

# ==================== INDEPENDENT VOICE / TTS API ====================
# TTS can use a completely different provider, Base URL and API key.
# If TTS_API_KEY is blank, AI_API_KEY is reused.
TTS_API_KEY=
TTS_API_BASE_URL=https://openrouter.ai/api/v1
TTS_API_PATH=/audio/speech
TTS_API_MODE=openai_speech
TTS_MODEL=fish-audio/s2.1-pro-free:free
TTS_FALLBACK_MODELS=
TTS_AUTH_HEADER=Authorization
TTS_AUTH_PREFIX=Bearer 
TTS_EXTRA_HEADERS_JSON={}
# openai_speech or custom_json
# custom_json template placeholders: {{model}}, {{input}}, {{text}}, {{voice}},
# {{speed}}, {{response_format}}, {{output_format}}.
TTS_REQUEST_TEMPLATE_JSON=
# raw_audio (binary response), json_base64, or json_url
TTS_RESPONSE_MODE=raw_audio
TTS_RESPONSE_AUDIO_PATH=audio
TTS_RESPONSE_URL_PATH=audio_url
# Set a field name blank to omit that field from the request.
# Voice/speed formats differ by provider; don't send parameters its API doesn't support.
TTS_VOICE_FIELD=
TTS_SPEED_FIELD=
TTS_FORMAT_FIELD=response_format
TTS_AUDIO_FORMAT=mp3
TTS_DEFAULT_VOICE=
TTS_DEFAULT_SPEED=1.0
TTS_CHUNK_CHARS=2600
TTS_MAX_CHARS=24000
TTS_TIMEOUT=180

# Local: leave blank for long-polling. Render automatically supplies RENDER_EXTERNAL_URL.
WEBHOOK_URL=
WEBHOOK_SECRET=
DATA_DIR=./data
DATABASE_PATH=./data/chatai.sqlite3
PORT=8000
LOG_LEVEL=INFO
