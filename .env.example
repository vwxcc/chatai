PORT=8000
DATA_DIR=./data
UPLOAD_DIR=./uploads
FRONTEND_DIR=./frontend
SESSION_SECRET=change-this-to-a-long-random-secret
MAX_FILE_SIZE=20971520
MAX_TOTAL_FILE_SIZE=52428800
MAX_FILES_PER_REQUEST=20
MAX_NAME_LENGTH=80
MAX_PROMPT_LENGTH=30000
MAX_SEARCH_LENGTH=200
REQUEST_TIMEOUT=300
GLOBAL_AI_CONCURRENCY=3
AI_SEND_IMAGES=true

# Session / CSRF security
SESSION_COOKIE_SECURE=1
CSRF_PROTECTION=1

# Comma-separated email addresses allowed to manage AI Router
ADMIN_EMAILS=admin@example.com

# Authentication rate limiting (seconds / attempts per IP)
AUTH_RATE_WINDOW=900
AUTH_LOGIN_LIMIT=10
AUTH_REGISTER_LIMIT=5
