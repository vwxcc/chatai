# HTTP / website
PORT=10000
DATA_DIR=./data
UPLOAD_DIR=./uploads
FRONTEND_DIR=./frontend
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
SESSION_COOKIE_SECURE=1
CSRF_PROTECTION=1

# Simultaneous upstream AI requests per process
GLOBAL_AI_CONCURRENCY=2
REQUEST_TIMEOUT=300
AI_CONNECT_TIMEOUT=20
MAX_FILE_SIZE=20971520
MAX_TOTAL_FILE_SIZE=52428800
MAX_FILES_PER_REQUEST=20
MAX_NAME_LENGTH=80
MAX_PROMPT_LENGTH=30000
MAX_SEARCH_LENGTH=200
MAX_FILE_CONTEXT_CHARS=500000
MAX_DOCUMENT_PAGES=500
MAX_SPREADSHEET_SHEETS=100
MAX_PRESENTATION_SLIDES=500

# Main AI API (OpenAI-compatible /chat/completions)
AI_API_BASE_URL=https://llm.stage.satel.org/v1
AI_API_KEY=
AI_API_KEY_ENV=AI_API_KEY
AI_MODEL=qwen36-35b
AI_FALLBACK_MODELS=
AI_TEMPERATURE=0.2
AI_MAX_TOKENS=7000

# Independent voice/TTS API (OpenAI-compatible /audio/speech)
TTS_API_BASE_URL=https://openrouter.ai/api/v1
TTS_API_PATH=/audio/speech
TTS_API_KEY=
TTS_MODEL=fish-audio/s2.1-pro-free:free
TTS_VOICE=
TTS_AUDIO_FORMAT=mp3
TTS_TIMEOUT=120
TTS_CHUNK_CHARS=2600
TTS_MAX_CHARS=24000

# Every completed answer is posted to this Telegram channel.
# Add the bot as channel administrator with posting rights.
TELEGRAM_BOT_TOKEN=
ARCHIVE_CHANNEL_ID=
TELEGRAM_TIMEOUT=25

# Dialogue context is kept in bounded RAM only, never in SQLite.
VOLATILE_HISTORY_MESSAGES=12
VOLATILE_HISTORY_CHARS=12000
VOLATILE_HISTORY_MAX_SESSIONS=128

# Optional administrators for the database AI Router
ADMIN_EMAILS=admin@example.com
AUTH_RATE_WINDOW=900
AUTH_LOGIN_LIMIT=10
AUTH_REGISTER_LIMIT=5
